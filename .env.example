# Copier ce fichier en .env et adapter si besoin.

# Prénom affiché dans l'interface ("Bonjour …")
NOM_UTILISATEUR=

# Matériel : auto (détection), cuda ou cpu
FORCE_DEVICE=auto

# Modèles (laisser vide pour le choix automatique selon le matériel)
# WHISPER_MODEL=small
# OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# Jeton Hugging Face (lecture) : identification des locuteurs par pyannote (voir README)
# HF_TOKEN=

# Accès à distance (moteur sur Kaggle/Colab, interface sur Vercel) : voir README
# CLE_ACCES=une-longue-phrase-secrete
# CORS_ORIGINES=["http://localhost:5173","https://mon-site.example"]
# CORS_REGEX=https://[a-z0-9-]+\.vercel\.app
